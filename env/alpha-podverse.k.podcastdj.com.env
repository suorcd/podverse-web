#####
##### podverse-web
#####

# Client side (public) env vars

NEXT_PUBLIC_SSR_API_PROTOCOL=http     # Internal service-to-service communication
NEXT_PUBLIC_SSR_API_HOST=podverse-api # Internal service-to-service communication
NEXT_PUBLIC_SSR_API_PORT=1234         # Internal service-to-service communication

# Keep Client-side API public (Browser needs to reach this)
NEXT_PUBLIC_API_PROTOCOL=https                          # TODO: Change this
NEXT_PUBLIC_API_HOST=api-alpha-podverse.k.podcastdj.com # TODO: Change this
NEXT_PUBLIC_API_PORT=

NEXT_PUBLIC_API_PREFIX=/api
NEXT_PUBLIC_API_VERSION=/v2

NEXT_PUBLIC_WEB_PROTOCOL=https
NEXT_PUBLIC_WEB_DOMAIN=alpha-podverse.k.podcastdj.com # TODO: Change this

NEXT_PUBLIC_BRAND_NAME=PDj-podverse # TODO: Change this

NEXT_PUBLIC_APP_VALUE_LIGHTNING_KEYSEND_NAME=PDj-podverse # TODO: Change this
NEXT_PUBLIC_APP_VALUE_LIGHTNING_KEYSEND_TYPE=node
NEXT_PUBLIC_APP_VALUE_LIGHTNING_KEYSEND_ADDRESS=fake9f91a0cb8ff43840e3c322c4c61f019d8c1c3cea15a25cfc425ac605e61a4a
